# STARBOUND backend — environment template.
# Copy to `.env` (same folder) and fill in REAL values on the backend host only.
# NEVER commit `.env`. NEVER put these values in frontend files or GitHub code.
# NAMES ONLY here — every value below is intentionally empty.

PORT=
MANTLEDB_BASE_URL=
MANTLEDB_NAMESPACE=
MANTLEDB_REVIEWS_ENTRY=
MANTLEDB_PROFILES_ENTRY=
MANTLEDB_API_KEY=
ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
MAX_BODY_BYTES=
# Password + session secrets (server host ONLY — never in code/frontend/git).
# AUTH_PEPPER must be a long random string (e.g. 32+ random bytes as hex).
# It is mixed into every password hash and never stored in the database.
AUTH_PEPPER=
# Optional tuning (defaults are safe to leave empty):
AUTH_SESSION_TTL_MS=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
